using Gtk 4.0;
using Adw 1;

template $BastleAppPage: Adw.NavigationPage {
  tag: "details";

  Adw.ToolbarView {
    [top]
    Stack headerbar_stack {
      StackPage {
        name: "details";

        child: Adw.HeaderBar normal_headerbar {
          show-title: false;
        };
      }

      StackPage {
        name: "edit";

        child: Adw.HeaderBar edit_headerbar {
          show-title: false;

          [start]
          Button {
            label: _("Cancel");
            clicked => $on_cancel_clicked() swapped;
          }

          [end]
          Button save_button {
            label: _("Save");
            sensitive: false;
            clicked => $on_save_clicked() swapped;

            styles ["suggested-action"]
          }
        };
      }
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;

      Adw.Clamp {
        maximum-size: 720;
        tightening-threshold: 560;
        margin-top: 18;
        margin-bottom: 36;
        margin-start: 18;
        margin-end: 18;

        Adw.ViewStack content_stack {
          vhomogeneous: false;

          Adw.ViewStackPage {
            name: "details";

            child: Box {
              orientation: vertical;
              spacing: 22;

              Box {
                orientation: vertical;
                spacing: 10;
                halign: center;

                Image details_icon {
                  icon-name: "io.github.cheviiot.bastle";
                  pixel-size: 128;
                  margin-top: 6;
                  margin-bottom: 6;
                }

                Label details_title {
                  wrap: true;
                  justify: center;
                  max-width-chars: 32;

                  styles ["title-1"]
                }

                Label details_domain {
                  ellipsize: middle;

                  styles ["dim-label", "heading"]
                }

                Label engine_status {
                  visible: false;

                  styles ["caption", "dim-label"]
                }
              }

              Adw.Banner engine_banner {
                revealed: false;
                title: _("This application needs the optional Chromium add-on.");
                button-label: _("Add-ons");
                button-clicked => $on_addons_clicked() swapped;
              }

              Button launch_button {
                label: _("Launch");
                halign: center;

                styles ["pill", "suggested-action"]
              }

              Adw.WrapBox actions_box {
                halign: center;
                justify: fill;
                child-spacing: 10;
                line-spacing: 10;

                Button {
                  icon-name: "document-edit-symbolic";
                  tooltip-text: _("Edit");
                  clicked => $on_edit_clicked() swapped;

                  styles ["circular"]
                }

                Button permissions_button {
                  icon-name: "system-lock-screen-symbolic";
                  tooltip-text: _("Permissions");

                  styles ["circular"]
                }

                Button privacy_button {
                  icon-name: "preferences-system-privacy-symbolic";
                  tooltip-text: _("Privacy & Power");

                  styles ["circular"]
                }

                Button repair_button {
                  icon-name: "view-refresh-symbolic";
                  tooltip-text: _("Repair Launcher");

                  styles ["circular"]
                }

                Button delete_button {
                  icon-name: "user-trash-symbolic";
                  tooltip-text: _("Delete Application");

                  styles ["circular", "destructive-action"]
                }
              }
            };
          }

          Adw.ViewStackPage {
            name: "edit";

            child: Box {
              orientation: vertical;
              spacing: 20;

              Adw.PreferencesGroup {
                title: _("Application");
                description: _("Identity and start address");

                Adw.EntryRow url_entry {
                  title: _("URL");
                  show-apply-button: true;
                  apply => $on_url_apply() swapped;
                }

                Adw.EntryRow title_entry {
                  title: _("Title");
                  max-length: 512;
                  changed => $update_unsaved_details_cb() swapped;
                }

                Adw.ActionRow {
                  title: _("Icon");
                  subtitle: _("Automatically normalized to 256×256");

                  Button {
                    icon-name: "image-symbolic";
                    valign: center;
                    clicked => $on_icon_clicked() swapped;

                    Image icon_image {
                      icon-name: "io.github.cheviiot.bastle";
                    }
                  }
                }
              }

              Adw.PreferencesGroup {
                title: _("Window");

                Adw.SwitchRow titlebar_color {
                  title: _("Website Titlebar Color");
                  subtitle: _("Use a valid theme color supplied by the website");
                  activated => $update_unsaved_details_cb() swapped;
                }
              }

              Adw.PreferencesGroup engine_group {
                title: _("Browser Engine");
                description: _("Profiles and cookies are never transferred between engines");

                Adw.ComboRow engine_row {
                  title: _("Engine");
                }

                Adw.ActionRow recommendation_row {
                  visible: false;
                  title: _("Chromium Recommended");
                  icon-name: "dialog-information-symbolic";

                  Button {
                    action-name: "win.addons";
                    label: _("Add-ons");
                    valign: center;

                    styles ["flat"]
                  }
                }
              }

              Adw.PreferencesGroup {
                title: _("Advanced");

                Adw.ExpanderRow user_agent_expander {
                  show-enable-switch: true;
                  expanded: bind user_agent_expander.enable-expansion;
                  title: _("Custom User Agent");

                  Adw.EntryRow user_agent_entry {
                    title: _("User Agent");
                    changed => $update_unsaved_details_cb() swapped;
                  }
                }
              }
            };
          }
        }
      }
    };
  }
}
