using Gtk 4.0;
using Adw 1;

template $BastleCreateAppDialog: Adw.Dialog {
  content-width: 720;
  content-height: 680;
  title: _("Add a New Application");

  Adw.ToastOverlay toast_overlay {
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar {}

      Adw.Clamp {
        maximum-size: 640;
        tightening-threshold: 560;
        margin-end: 18;
        margin-start: 18;
        margin-top: 12;
        margin-bottom: 18;

        Box {
          orientation: vertical;
          spacing: 15;

          ListBox {
          styles [
            "boxed-list"
          ]

          selection-mode: none;

          Adw.EntryRow url_entry {
            title: _("URL");
            show-apply-button: true;
            sensitive: bind template.loading inverted;
            apply => $on_url_apply() swapped;
            changed => $validate_input_cb() swapped;

            Adw.Spinner {
              visible: bind template.loading;
            }
          }

          Adw.EntryRow title_entry {
            title: _("Title");
            max-length: 512;
            sensitive: bind template.loading inverted;
            changed => $validate_input_cb() swapped;

            // Aligns the edit indicator of title_entry with url_entry
            Spinner {
              visible: false;
            }
          }

          Adw.ActionRow {
            title: _("Icon");
            subtitle: _("Website favicon, Icon Horse, or a local file");
            sensitive: bind template.loading inverted;

            Box {
              orientation: horizontal;
              spacing: 6;
              valign: center;

              Button site_icon_button {
                valign: center;
                sensitive: bind template.loading inverted;
                clicked => $on_site_icon_clicked() swapped;

                Stack {
                  Label {
                    label: _("Get Site Icon");
                    visible: bind template.provider-loading inverted;
                  }

                  Adw.Spinner {
                    visible: bind template.provider-loading;
                  }
                }
              }

              Button {
                icon-name: "image-symbolic";
                valign: center;
                sensitive: bind template.loading inverted;
                tooltip-text: _("Choose Icon File");
                clicked => $on_icon_clicked() swapped;

                Image icon_image {}
              }
            }
          }

          Label icon_provider_status {
            visible: false;
            wrap: true;
            xalign: 0;
            margin-start: 12;
            margin-end: 12;

            styles ["dim-label", "caption"]
          }

          Adw.ComboRow engine_row {
            title: _("Browser Engine");
            subtitle: _("WebKitGTK is the default; Chromium is available as a Bastle add-on");
          }

          Adw.ActionRow recommendation_row {
            visible: false;
            title: _("Chromium Recommended");
            icon-name: "dialog-information-symbolic";

            Button {
              action-name: "win.addons";
              label: _("Add-ons");
              valign: center;

              styles ["flat"]
            }
          }
          }

          Button button {
            halign: center;
            valign: end;
            vexpand: true;

            styles [
              "pill",
              "suggested-action"
            ]

            sensitive: false;

            Stack button_stack {
              Label button_label {
                label: _("Create");
              }

              Adw.Spinner button_spinner {}
            }

            clicked => $on_create_clicked() swapped;
          }
        }
      }
    }
  }
}
