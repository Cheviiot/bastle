{
  "id": "io.github.cheviiot.bastle",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "bastle",
  "separate-locales": false,
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--talk-name=io.github.cheviiot.bastle_chromium"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "RUST_BACKTRACE": "1",
      "RUST_LOG": "bastle=debug"
    }
  },
  "modules": [
    {
      "name": "blueprint-compiler",
      "buildsystem": "meson",
      "cleanup": ["*"],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler",
          "tag": "v0.18.0",
          "commit": "07c9c9df9cd1b6b4454ecba21ee58211e9144a4b"
        }
      ]
    },
    {
      "name": "bastle",
      "builddir": true,
      "buildsystem": "meson",
      "config-opts": ["-Dflatpak=true"],
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/bastle/cargo"
        }
      },
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".git",
            ".flatpak-build",
            ".flatpak-builder",
            ".flatpak-build-v03",
            ".flatpak-builder-v03",
            "build",
            "target"
          ]
        },
        "generated-sources.json"
      ]
    }
  ]
}
