<schemalist gettext-domain="bastle">
  <schema id="io.github.cheviiot.bastle" path="/io/github/cheviiot/bastle/">
    <key name="window-width" type="i">
      <default>800</default>
    </key>
    <key name="window-height" type="i">
      <default>600</default>
    </key>
    <key name="library-sort-mode" type="s">
      <default>'title-asc'</default>
      <choices>
        <choice value="title-asc"/>
        <choice value="title-desc"/>
        <choice value="newest"/>
        <choice value="oldest"/>
      </choices>
      <summary>Application library sorting mode</summary>
    </key>
  </schema>
</schemalist>
