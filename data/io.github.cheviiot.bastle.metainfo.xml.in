<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<component type="desktop-application">
  <id>io.github.cheviiot.bastle</id>
  <name>Bastle</name>
  <summary>Create isolated web applications for GNOME</summary>
  <developer id="io.github.cheviiot">
    <name>Cheviiot and Bastle contributors</name>
    <url>https://github.com/Cheviiot</url>
  </developer>
  <icon type="stock">io.github.cheviiot.bastle</icon>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <content_rating type="oars-1.1" />
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <branding>
    <color type="primary" scheme_preference="light">#3A7D78</color>
    <color type="primary" scheme_preference="dark">#344955</color>
  </branding>
  <description>
    <p>
      Bastle is a GNOME-native manager for isolated web applications. WebKitGTK
      is the default engine, and Chromium is available as a Flatpak add-on for
      explicitly selected sites. Each website gets separate local data, cookies,
      cache, settings, and its own desktop launcher.
    </p>
    <p>
      Bastle is an independent successor to Spider. The original work by
      Zaedus, Cameron Radmore's contribution, and their Git history remain
      credited. Bastle is developed independently and does not claim their
      endorsement or participation.
    </p>
    <ul>
      <li>Create, edit, repair, and remove portal-installed launchers</li>
      <li>Fetch and safely normalize website icons with an offline fallback; an optional Icon Horse request is made only by explicit user action</li>
      <li>Keep each application's configuration, policy, profile, and cache separate</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/Cheviiot/bastle</url>
  <url type="bugtracker">https://github.com/Cheviiot/bastle/issues</url>
  <url type="vcs-browser">https://github.com/Cheviiot/bastle</url>
  <categories>
    <category>Network</category>
    <category>WebBrowser</category>
  </categories>
  <launchable type="desktop-id">io.github.cheviiot.bastle.desktop</launchable>
  <releases>
    <release version="0.7.0" date="2026-09-07">
      <description>
        <ul>
          <li>Replace the library grid with an adaptive GNOME list, search, sorting, and keyboard navigation</li>
          <li>Add a site-only Icon Horse favicon fallback with safe hostname checks, cache, and PNG normalization</li>
          <li>Add accessible application details actions and explicit site-icon controls for creation and editing</li>
        </ul>
      </description>
      <url>https://github.com/Cheviiot/bastle/releases/tag/v0.7.0</url>
    </release>
    <release version="0.6.0" date="2026-09-06">
      <description>
        <ul>
          <li>Redesign the library as an adaptive card grid with search, sorting, and application details</li>
          <li>Keep WebKitGTK as the default and make Chromium an optional, manually installed add-on</li>
          <li>Add a trusted local Chromium toolbar built with secure WebContentsView isolation</li>
          <li>Add explicit add-on diagnostics, restart guidance, and one-time WebKit fallback</li>
        </ul>
      </description>
      <url>https://github.com/Cheviiot/bastle/releases/tag/v0.6.0</url>
    </release>
    <release version="0.5.2" date="2026-09-05">
      <description>
        <ul>
          <li>Move the Chromium payload from the main app into a Flatpak add-on</li>
          <li>Publish the app and add-on together from the signed Bastle repository</li>
          <li>Keep WebKitGTK usable when the Chromium add-on is not installed</li>
          <li>Add clear installation and compatibility diagnostics for the add-on</li>
        </ul>
      </description>
      <url>https://github.com/Cheviiot/bastle/releases/tag/v0.5.2</url>
    </release>
    <release version="0.5.1" date="2026-09-05">
      <description>
        <ul>
          <li>Embed the Chromium engine into the single Bastle Flatpak</li>
          <li>Remove the need to install or update a separate Chromium package</li>
          <li>Keep WebKitGTK as the default and retain separate per-engine profiles</li>
          <li>Activate Chromium through an internal service owned by the Bastle app ID</li>
          <li>Publish a GPG-signed project Flatpak repository for x86_64 and aarch64</li>
          <li>Clarify the GPL-3.0-only license and preserved Spider authorship</li>
        </ul>
      </description>
      <url>https://github.com/Cheviiot/bastle/releases/tag/v0.5.1</url>
    </release>
    <release version="0.5.0" date="2026-09-05">
      <description>
        <ul>
          <li>Add an explicit WebKitGTK or Chromium engine choice with local compatibility recommendations</li>
          <li>Integrate the separately sandboxed Chromium companion through an authenticated D-Bus protocol</li>
          <li>Keep engine profiles separate and safely retry deferred companion profile cleanup</li>
          <li>Diagnose Dynamic Launcher, File Chooser, and Documents portal capabilities independently</li>
          <li>Distinguish unavailable, unsupported, cancelled, denied, and failed portal operations</li>
        </ul>
      </description>
      <url>https://github.com/Cheviiot/bastle/releases/tag/v0.5.0</url>
    </release>
    <release version="0.4.0" date="2026-09-05">
      <description>
        <ul>
          <li>Add opt-in navigation allowlists, proxy settings, background mode, autostart, and content filters</li>
          <li>Add a threat model for websites, profiles, portals, backups, and the future companion boundary</li>
          <li>Keep every new privacy and power feature disabled until the user enables it</li>
          <li>Serialize portal reconciliation and safely merge concurrent policy edits</li>
          <li>Require fresh background authorization after restore while preserving other policy</li>
        </ul>
      </description>
      <url>https://github.com/Cheviiot/bastle/releases/tag/v0.4.0</url>
    </release>
    <release version="0.3.0" date="2026-09-05">
      <description>
        <ul>
          <li>Add versioned metadata backups with transactional per-application restore</li>
          <li>Add optional passphrase-encrypted transfer of cookies and site storage</li>
          <li>Add conflict preview, partial-failure reporting, and runtime profile locks</li>
          <li>Add portal capability diagnostics and native aarch64 release bundles</li>
          <li>Harden archive extraction, resource limits, and concurrent profile operations</li>
        </ul>
      </description>
      <url>https://github.com/Cheviiot/bastle/releases/tag/v0.3.0</url>
    </release>
    <release version="0.2.0" date="2026-09-05">
      <description>
        <ul>
          <li>Add per-origin website permissions with session and persistent choices</li>
          <li>Add popup and OAuth windows, native notifications, and managed downloads</li>
          <li>Add navigation, zoom, and fullscreen runtime controls</li>
          <li>Migrate Bastle data to schema v2 and remove Spider runtime compatibility</li>
        </ul>
      </description>
      <url>https://github.com/Cheviiot/bastle/releases/tag/v0.2.0</url>
    </release>
    <release version="0.1.1" date="2026-09-05">
      <description>
        <ul>
          <li>Prevent a crash when opening an application card for editing</li>
          <li>Add a headless regression test for editor state changes</li>
        </ul>
      </description>
      <url>https://github.com/Cheviiot/bastle/releases/tag/v0.1.1</url>
    </release>
    <release version="0.1.0" date="2026-09-04">
      <description>
        <ul>
          <li>Introduce the Bastle identity and isolated JSON-based storage</li>
          <li>Add transactional launcher operations and repair support</li>
          <li>Add an explicit, settings-only Spider importer</li>
          <li>Harden URL, metadata, icon, download, and theme-color handling</li>
        </ul>
      </description>
      <url>https://github.com/Cheviiot/bastle/releases/tag/v0.1.0</url>
    </release>
  </releases>
</component>
